uests were not affected.\n\nThe cause was contention in our database when recording usage. We've changed how usage is recorded to remove that contention.\n\nUsage from this period may be missing from your usage reports. You were not charged for any request whose usage wasn't recorded, and payments were not affected.\n\nThis page didn't show the incident at the time because it only flagged Console errors above 5% of requests. It now also reports Console slowness and smaller error spikes."}],"history":[{"start":1791817200000,"services":{"console":"operational","logs":"operational","inference":"operational","go":"unknown","payg":"unknown","free":"unknown"},"models":{}},{"start":1791828000000,"services":{"console":"operational","logs":"operational","inference":"operational","go":"unknown","payg":"unknown","free":"unknown"},"models":{}},{"start":1791838800000,"services":{"console":"operational","logs":"operational","inference":"operational","go":"unknown","payg":"unknown","free":"unknown"},"models":{}},{"start":1791849600000,"services":{"console":"operational","logs":"operational","inference":"operational","go":"unknown","payg":"unknown","free":"unknown"},"models":{}},{"start":1791860400000,"services":{"console":"operational","logs":"operational","inference":"operational","go":"unknown","payg":"unknown","free":"unknown"},"models":{}},{"start":1791871200000,"services":{"console":"degraded","logs":"operational","inference":"operational","go":"unknown","payg":"unknown","free":"unknown"},"models":{}},{"start":1791882000000,"services":{"console":"operational","logs":"operational","inference":"operational","go":"unknown","payg":"unknown","free":"unknown"},"models":{}},{"start":1791892800000,"services":{"console":"operational","logs":"operational","inference":"operational","go":"unknown","payg":"unknown","free":"unknown"},"models":{}},{"start":1791903600000,"services":{"console":"degraded","logs":"degraded","inference":"degraded","go":"unknown","payg":"unknown","free":"unknown"