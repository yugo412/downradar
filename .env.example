# Copy this file to .env and adjust. .env is gitignored.

# --- Database ---
POSTGRES_USER=downradar
POSTGRES_PASSWORD=downradar
POSTGRES_DB=downradar

# --- Cache ---
# Cache and ephemeral state. Both compose files point this at the redis
# service, so the value here documents the address rather than deciding it.
REDIS_URL=redis://redis:6379/0

# --- Site ---
# Used for canonical URLs in the sitemap and on the API documentation page.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Page cache ---
# How long a rendered page is cached. Set to 0 while working on the UI, so an
# edit shows up immediately instead of up to a minute later.
NUXT_PAGE_CACHE_SECONDS=60

# --- Internal API access ---
# Shared secret between the Nuxt proxy and the Go API. The proxy sends it as
# X-Internal-Token on every /api/v1/** request it forwards, which tells the API
# two things: this traffic is ours (so skip the read rate limit) and
# X-Forwarded-For can be trusted for the real client IP.
# Generate one with: openssl rand -hex 32
INTERNAL_TOKEN=change-me

# --- Public API rate limits ---
# Applies to anonymous callers. Internal traffic is exempt.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

# --- Suggest a service ---
# How often one visitor may submit a suggestion, on average, and how many
# attempts are allowed back to back. The burst is deliberately forgiving:
# a typo in the form should not lock someone out for ten minutes.
SUGGEST_RATE_LIMIT_PER_HOUR=6
SUGGEST_RATE_LIMIT_BURST=5

# Shown as a link in the footer. Not used by the API.
GITHUB_REPO=

# --- Staff sign in ---
# Sessions live in an httpOnly, SameSite=Lax cookie. SESSION_COOKIE_SECURE has
# to be true in production: without it the cookie would travel over plain http.
# The dev compose file forces it to false, because the dev site is http.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE=dr_session
SESSION_TTL=720h

# How many sign in attempts one IP gets. Deliberately small: a wrong password
# is a typo, a few hundred is an attack.
LOGIN_RATE_LIMIT_PER_HOUR=20
LOGIN_RATE_LIMIT_BURST=5

# The same for changing a password, kept in its own bucket: mistyping a sign in
# must not use up the budget for changing a password, or the other way round.
# Hashing is deliberately slow, so this endpoint is worth throttling.
PASSWORD_RATE_LIMIT_PER_HOUR=20
PASSWORD_RATE_LIMIT_BURST=5

# Asking for a sign in link puts a message into any inbox somebody types, so it
# has a tighter budget than the form it sits on. Signing in with the link does
# not send anything and is counted with registering and resets instead.
LINK_RATE_LIMIT_PER_HOUR=6
LINK_RATE_LIMIT_BURST=5

# Registering, confirming an address, asking for a reset link and using one.
# Each of them can send an email to an address somebody typed, so they get their
# own budget. The burst is roomier than the rate on purpose: one person may
# register, ask for the link again and reset a password in the same minute.
ACCOUNT_RATE_LIMIT_PER_HOUR=5
ACCOUNT_RATE_LIMIT_BURST=10

# Accounts are created from the shell, there is no registration form:
#   downradar-user -email you@example.com -name "Your Name" -role admin
# Add -reset to change the password of an account that already exists.


# --- Signing in with GitHub ---
# Visitors can sign in with a GitHub account as well as with an address and a
# password. Create an OAuth App at https://github.com/settings/developers and
# put the client id and secret it gives you here. The authorization callback URL
# on that page has to be PUBLIC_URL plus /api/v1/auth/github/callback, which is
# http://localhost:3000/api/v1/auth/github/callback in development.
#
# With either value empty the button is not offered and the routes say the
# provider is not configured, the way the site does not offer to email a link
# while there is no mail server.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The same for Google, from https://console.cloud.google.com/apis/credentials.
# Its OAuth client takes more than one redirect URI, so one client can serve both
# the dev site and production: PUBLIC_URL plus /api/v1/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- Adding a Slack channel in one click ---
# The alert page can also connect a Slack channel without pasting anything. The
# button installs the site's own Slack app: Slack asks which workspace and
# channel to post to, and the incoming webhook it makes is saved with the alert.
#
# Create the app at https://api.slack.com/apps, add the incoming-webhook scope
# under OAuth & Permissions, and register this redirect URL there too:
#
#   PUBLIC_URL + /api/v1/slack/callback
#
# which is http://localhost:3000/api/v1/slack/callback in development and
# https://downradar.info/api/v1/slack/callback in production. Slack matches the
# address exactly, so the path is fixed; the alert it belongs to travels in the
# flow's own state instead. A dry run on localhost is fine, but a plain HTTP
# redirect keeps the app from being distributed, so take that one out before the
# production address is the only one left.
#
# Only the client id and secret are read here. The signing secret is for Slack
# events sent to the app, which this site does not take. With either value empty
# the one click path is off: the page says so and the manual webhook field below
# it still works.
#
# For people outside your own workspace to install it, the app has to be
# distributed (Manage Distribution) rather than left in Testing.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=


# --- Raw payload history ---
# The raw response from each vendor is kept so a parser fix can be replayed over
# history. Responses usually differ on every poll because they embed timestamps
# and moving time series, so storing each poll would cost around 200 MB a day.
# Instead at most one payload per vendor per interval is kept, which bounds it
# to roughly 100 MB for the retention window below.
RAW_PAYLOAD_MIN_INTERVAL=1h
RAW_PAYLOAD_RETENTION_DAYS=7

# --- Alerts ---
# Visitors can ask to be emailed when a vendor changes status. The mail goes out
# over SMTP, and in development Mailpit catches it: the address below is the
# mailpit container, and the messages appear at http://localhost:8026. Without
# SMTP_ADDR the feature is off, and the API refuses subscriptions rather than
# taking them and sending nothing.
#
# SMTP_ADDR is host:port. Port 465 is dialled with TLS from the first byte, which
# is what that port means; any other port is dialled plainly and upgraded with
# STARTTLS when the server offers it.
SMTP_ADDR=mailpit:1025
# Only needed when the server asks for a login.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=DownRadar <alerts@downradar.test>

# Seals secrets the database keeps, starting with the webhook headers, webhook
# signing secret and Telegram bot token in an alert channel's settings. Generate
# it with:
#   openssl rand -hex 32
# It is required while alerts are enabled and has to survive a restart. Losing
# it makes those saved values unreadable; keep it out of the database.
APP_KEY=change-me

# A background sender has no request to read the site address from, so the links
# it writes into an email come from here. In production this has to be the public
# address, or every link points at localhost.
PUBLIC_URL=http://localhost:3000

# How often one visitor may ask for an alert, on average, and how many at once.
# A subscription sends mail to an address somebody typed, so this is kept small.
ALERT_RATE_LIMIT_PER_HOUR=6
ALERT_RATE_LIMIT_BURST=5

# Trying a webhook or chat from the setup screen has a budget of its own, so a
# few corrections in a row do not use up the subscription budget. It is still
# bounded, because each try calls somebody else's end.
ALERT_TEST_RATE_LIMIT_PER_HOUR=60
ALERT_TEST_RATE_LIMIT_BURST=10

# How many services one subscriber account may watch at once, counted per
# vendor rather than per thing watched inside one. A guest gets one, and staff
# are not capped. Zero falls back to the default.
#
# This is only the value a new account is given: it is written to the account's
# own row (user_limits), and that row is what is read, so one account can be
# changed without touching the environment.
ALERT_LIMIT_PER_SUBSCRIBER=10

# How often the sender looks for email that is waiting to go out. The default is
# short so a change shows up in Mailpit almost at once; a production server can
# afford to wait longer.
ALERT_SEND_INTERVAL=5s

# --- Generated summaries ---
# A short sentence above a vendor's open incidents, written from the same
# official state the page shows. It is stored when the state changes, and the
# page and alert emails read the stored copy rather than calling a model while
# somebody is waiting. Without OPENAI_API_KEY the feature is off and no new
# sentence is written; rows already stored are left alone.
#
# SUMMARY_ENABLED turns the feature off even when a key is set. With it false no
# worker starts and the model is never called; the page and alert emails also
# leave out a stored sentence, which stays in the database for when the switch
# is turned back on.
#
# Keep the key in .env, never in this file: .env is gitignored and this one is
# committed. The base URL can point at a local or compatible endpoint; it ends
# at the API root, not at the chat completions path.
SUMMARY_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=20s

# --- Contact form ---
# Where a message from the contact form is delivered. The reply address is set to
# whoever wrote in, so answering is a reply rather than a copy and paste. Without
# SMTP_ADDR the form is refused, the same as alerts and account mail.
CONTACT_EMAIL=support@downradar.info

# How often one visitor may send a message, on average, and how many at once. A
# message mails the owner, so this is kept small.
CONTACT_RATE_LIMIT_PER_HOUR=6
CONTACT_RATE_LIMIT_BURST=5
